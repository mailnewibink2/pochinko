# Cloudinary Credentials for Direct Browser Upload
# 1. Sign up/Login to Cloudinary.
# 2. Get your "Cloud Name" from the Dashboard.
# 3. Go to Settings -> Upload -> Add upload preset.
# 4. Set Signing Mode to "Unsigned" and save. Copy the preset name.

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here
